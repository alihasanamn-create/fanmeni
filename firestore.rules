rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function admin() {
      return signedIn() && (
        request.auth.token.email == 'fanmeni@login.fanmeni.app' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // A captain is identified by membership in the admin-managed captains
    // collection. The role field is kept optional for compatibility with
    // captain accounts created by older versions of the app.
    function captain() {
      return signedIn() &&
        exists(/databases/$(database)/documents/captains/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/captains/$(request.auth.uid)).data.active != false;
    }

    function captainTeam() {
      return get(/databases/$(database)/documents/captains/$(request.auth.uid)).data.teamId;
    }

    function publicRead() { return !signedIn(); }

    match /admins/{uid} {
      allow read: if admin() || captain() || (signedIn() && request.auth.uid == uid);
      allow write: if admin();
    }

    match /users/{uid} {
      allow read: if admin() || captain() || (signedIn() && request.auth.uid == uid);
      allow write: if admin() || (signedIn() && request.auth.uid == uid && !captain());
    }

    match /captains/{uid} {
      allow read: if admin() || captain();
      allow create, update, delete: if admin();
    }

    // Captains can view the same dashboard data as admins.
    match /teams/{teamId} {
      allow read: if publicRead() || admin() || captain();
      allow create, update, delete: if admin();
    }

    match /students/{studentId} {
      allow read: if publicRead() || admin() || captain();
      allow create, delete: if admin();
      // The only student write a captain can perform is assignment sync
      // generated by the shared Assign Candidates page for their own team.
      allow update: if admin() || (
        captain() &&
        resource.data.teamId == captainTeam() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'assignedPrograms', 'programsCount', 'updatedAt'
        ])
      );
    }

    match /arts/{programId} {
      allow read: if publicRead() || admin() || captain();
      allow create, update, delete: if admin();
    }

    match /sports/{programId} {
      allow read: if publicRead() || admin() || captain();
      allow create, update, delete: if admin();
    }

    match /arts_programs/{programId} {
      allow read: if publicRead() || admin() || captain();
      allow create, update, delete: if admin();
    }

    match /sports_programs/{programId} {
      allow read: if publicRead() || admin() || captain();
      allow create, update, delete: if admin();
    }

    match /results/{resultId} {
      allow read: if publicRead() || admin() || captain();
      allow create, update, delete: if admin();
    }

    match /teamPoints/{docId} {
      allow read: if publicRead() || admin() || captain();
      allow create, update, delete: if admin();
    }

    match /gallery/{docId} {
      allow read: if publicRead() || admin() || captain();
      allow create, update, delete: if admin();
    }

    match /settings/{docId} {
      allow read: if publicRead() || admin() || captain();
      allow create, update, delete: if admin();
    }

    match /broadcastHistory/{docId} {
      allow read: if publicRead() || admin() || captain();
      allow create, update, delete: if admin();
    }

    match /liveQueue/{docId} {
      allow read: if publicRead() || admin() || captain();
      allow create, update, delete: if admin();
    }

    // Candidate assignments are the one main collection captains can edit.
    // The shared CandidatesDashboard restricts a captain to their own team.
    match /participants/{docId} {
      allow read: if publicRead() || admin() || captain();
      allow create, update: if admin() || captain();
      allow delete: if admin();
    }

    // Retained for compatibility with earlier captain-submission data.
    match /candidateEntries/{entryId} {
      allow read: if admin() || (captain() && resource.data.teamId == captainTeam());
      allow create, update, delete: if admin();
    }

    match /scores/{docId} {
      allow read: if publicRead() || admin() || captain();
      allow write: if admin();
    }

    match /notifications/{docId} {
      allow read: if admin() || captain();
      allow write: if admin();
    }

    match /activityLogs/{docId} {
      allow read: if admin() || captain();
      allow write: if admin();
    }

    match /downloads/{docId} {
      allow read: if publicRead() || admin() || captain();
      allow write: if admin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
